---
import Layout from '../layouts/Layout.astro';
import pages from '../data/pages.json';

export async function getStaticPaths() {
  const mods = import.meta.glob('../data/content/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
  return pages
    .filter((p) => p.slug !== 'index')
    .map((p) => {
      const key = Object.keys(mods).find((k) => k.endsWith('/' + p.slug + '.html'));
      return {
        params: { slug: p.slug },
        props: { meta: p, html: key ? mods[key] : '' },
      };
    });
}

const { meta, html } = Astro.props;
---
<Layout title={meta.title} description={meta.desc} slug={meta.slug}>
  <Fragment set:html={html} />
</Layout>
