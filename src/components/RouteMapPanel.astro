---
import StopStrip from './StopStrip.astro';
import FactBar from './FactBar.astro';
/* Panel peta rute malam: Medan → Sinaksak → Siantar → Parapat (SVG inline) */
const stops = [
  { name: 'Medan', note: 'Amplas · SM Raja' },
  { name: 'Sinaksak', note: 'keluar tol' },
  { name: 'Pematang Siantar', note: '±126–128 km' },
  { name: 'Parapat', note: 'gerbang Danau Toba' },
];
const facts = [
  { k: 'Medan → Parapat', v: '±176 km' },
  { k: 'Durasi bus', v: '3–4 jam' },
  { k: 'Bus AKDP', v: 'Rp60–80 ribu' },
];
---
<aside class="map-panel" aria-label="Peta rute Medan ke Danau Toba">
  <h3>Peta lintas malam ini</h3>
  <p class="mp-sub">Koridor tersibuk dari Medan — tol sampai Sinaksak, lalu menanjak ke Danau Toba.</p>
  <svg viewBox="0 0 460 210" role="img" aria-label="Rute Medan, Sinaksak, Pematang Siantar, Parapat">
    <defs>
      <radialGradient id="glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#25C3E8" stop-opacity=".55" />
        <stop offset="100%" stop-color="#25C3E8" stop-opacity="0" />
      </radialGradient>
    </defs>
    <g fill="#8F89D8">
      <circle cx="40" cy="26" r="1.6" /><circle cx="120" cy="14" r="1.2" /><circle cx="210" cy="30" r="1.5" />
      <circle cx="330" cy="16" r="1.2" /><circle cx="420" cy="36" r="1.6" /><circle cx="70" cy="60" r="1.1" />
      <circle cx="390" cy="70" r="1.1" /><circle cx="180" cy="58" r="1" /><circle cx="285" cy="48" r="1.3" />
    </g>
    <path d="M52 168 C 150 150, 210 128, 268 104 S 372 58, 408 40" fill="none" stroke="#25C3E8" stroke-width="3" stroke-dasharray="7 6" stroke-linecap="round" />
    <circle cx="52" cy="168" r="26" fill="url(#glow)" /><circle cx="268" cy="104" r="22" fill="url(#glow)" /><circle cx="408" cy="40" r="26" fill="url(#glow)" />
    <g font-family="Public Sans, sans-serif">
      <circle cx="52" cy="168" r="7" fill="#25C3E8" stroke="#12102A" stroke-width="2.5" />
      <text x="52" y="192" fill="#FFFFFF" font-size="13" font-weight="700" text-anchor="middle">Medan</text>
      <circle cx="176" cy="138" r="5" fill="#12102A" stroke="#25C3E8" stroke-width="2.5" />
      <text x="176" y="160" fill="#D9F5FD" font-size="11.5" text-anchor="middle">Sinaksak</text>
      <circle cx="268" cy="104" r="6" fill="#FFFFFF" stroke="#25C3E8" stroke-width="2.5" />
      <text x="268" y="128" fill="#FFFFFF" font-size="12.5" font-weight="700" text-anchor="middle">Pematang Siantar</text>
      <circle cx="408" cy="40" r="7" fill="#25C3E8" stroke="#12102A" stroke-width="2.5" />
      <text x="408" y="24" fill="#FFFFFF" font-size="13" font-weight="700" text-anchor="middle">Parapat · Toba</text>
    </g>
    <text x="16" y="30" fill="#8F89D8" font-size="10.5" letter-spacing="2">LINTAS TIMUR · TOL SINAKSAK</text>
  </svg>
  <StopStrip stops={stops} />
  <FactBar facts={facts} />
</aside>
